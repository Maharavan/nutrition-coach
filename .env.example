# OpenAI Configuration
API_KEY=sk-...  # Your OpenAI API key

# Strands Agent Framework Configuration
MEM0_API_KEY=...  # Your Mem0 API key (for persistent memory)

# Tavily Search Configuration
TAVILY_API_KEY=...  # Your Tavily API key (for web search)

# Agent Configuration (Optional - these have defaults)
# AGENT_MODEL_NAME=gpt-4o          # Primary model (default: gpt-4o)
# AGENT_FALLBACK_MODEL_NAME=gpt-4o-mini  # Fallback model (default: gpt-4o-mini)
# AGENT_MAX_TOKENS=4096            # Max tokens in response (default: 4096)
# AGENT_TEMPERATURE=0.3            # Temperature for responses (default: 0.3)
# TOOL_MODEL_NAME=gpt-4o           # Model for tools (default: gpt-4o)
# TOOL_FALLBACK_MODEL_NAME=gpt-4o-mini  # Fallback for tools (default: gpt-4o-mini)

# Application Configuration
# LOG_LEVEL=INFO                   # Logging level (default: INFO)
